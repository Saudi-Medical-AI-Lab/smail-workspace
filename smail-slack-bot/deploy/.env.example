SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_CHANNEL_ID=C0123456789
# * = anyone in the private channel, or list IDs like U01AAAA,U02BBBB
REQUESTER_USER_IDS=*
# Same here: * = anyone in the private channel may Approve
APPROVER_USER_IDS=*
GITHUB_OWNER=Saudi-Medical-AI-Lab
GITHUB_REPO=smail
GITHUB_BRANCH=main
# Fine-grained token, this repo only: Contents RW, Pull requests RW, Pages R, Metadata R
GITHUB_TOKEN=github_pat_...
COMMIT_AUTHOR_NAME=SMAIL Bot
COMMIT_AUTHOR_EMAIL=bot@example.com
PREVIEW_ROOT=/var/www/previews
PREVIEW_BASE_URL=https://preview.example.com
SITE_URL=https://smail.org.sa
# From `claude setup-token` on a laptop. Do NOT set ANTHROPIC_API_KEY (the bot refuses to start if it is set).
CLAUDE_CODE_OAUTH_TOKEN=...
# Set to 1 to build previews but never publish (use for the first tests)
DRY_RUN=1
